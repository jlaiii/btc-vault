# BTC Vault — environment template.
#
# scripts/setup.sh writes a real .env from this shape with freshly generated secrets.
# Never commit a real .env: SECRET_KEY (session signing) and POSTGRES_PASSWORD are on it,
# and the wallet's master key belongs in secrets/master.key, outside the database.

# --- secrets: generate with openssl rand -hex 24 / -hex 48 ---
POSTGRES_PASSWORD=change-me-postgres-password
SECRET_KEY=change-me-96-hex-chars

# --- bitcoin network: testnet | mainnet ---
# Changing this is a DATA MIGRATION, not a restart: derivation paths differ per network,
# so every stored address would belong to the other chain. Use `cli launch-network`.
BTC_NETWORK=testnet

SITE_NAME=BTC Vault
# Public origin. HTTPS is required in practice: the session cookie is `Secure`.
SITE_URL=https://vault.example.com

# Leave empty to use the network defaults (mempool.space primary, blockstream.info failover)
ESPLORA_URLS=

# --- where the AES master key lives (mounted read-only, 0600, uid 1500) ---
MASTER_KEY_FILE=/run/secrets/master.key
SEED_BACKUP_FILE=/run/secrets/HOTWALLET_MNEMONIC.txt

# 1 = cookie only over HTTPS. Set 0 ONLY for a local plain-HTTP run; with 0 the
# test suites over http:// work, and with 1 they need TLS or every POST fails CSRF.
COOKIE_SECURE=1

# How long a password re-entry ("sudo mode") unlocks sensitive actions
SUDO_WINDOW_SECONDS=900

# --- money policy (also editable live in Admin → Settings) ---
SERVICE_FEE_PCT=0.5
SERVICE_FEE_MIN_SAT=0
# Sends at or below this go out immediately; larger ones wait for admin approval
INSTANT_SEND_MAX_SAT=200000
WITHDRAW_MIN_SAT=10000
WITHDRAW_DAILY_MAX_SAT=5000000
# 2 or more before real money: a single confirmation can still be reorged away
MIN_CONFIRMATIONS=1

# --- fee oracle bounds (sat/vB) ---
MIN_FEE_RATE=1
MAX_FEE_RATE=500

# --- abuse limits (all counted in Postgres, so they survive restarts) ---
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_PER_10MIN=20
SIGNUP_IP_MAX_PER_HOUR=3
SIGNUP_IP_MAX_ATTEMPTS=20
SEND_MAX_PER_HOUR=10
GLOBAL_IP_MAX_WRITES_PER_10MIN=150
PASSWORD_MIN_LENGTH=10

# --- chain watcher ---
SYNC_INTERVAL_SECONDS=60
SYNC_ADDRESS_DELAY_MS=250

# --- mail (only used by the legacy reset flow; the app has no self-service reset) ---
MAIL_ENABLED=1
MAIL_HOST=host.docker.internal
MAIL_PORT=25
MAIL_FROM=vault@example.com

# --- create tables/indexes/sequence on boot (keep 1) ---
AUTO_CREATE_TABLES=1
